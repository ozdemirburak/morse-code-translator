# Install only package versions that are at least 3 days old. Needs npm 11.10 or
# later, which devEngines in package.json requires; Dependabot uses the same cooldown.
min-release-age=3
# Never run install scripts of dependencies; none of the dev tools needs one.
ignore-scripts=true
# Refuse a dependency whose engines field does not allow the current Node version.
engine-strict=true
