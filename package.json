{
  "name": "@ozdemirburak/morse-code-translator",
  "version": "8.0.1",
  "description": "Morse code translator helps you convert text to Morse code and vice versa, with the option to play Morse code audio.",
  "keywords": [
    "morse",
    "morse alphabet",
    "morse code",
    "morse decoder",
    "morse encoder",
    "morse translator",
    "morse code translator",
    "morse code decoder"
  ],
  "license": "MIT",
  "homepage": "https://morsecodetranslator.com",
  "author": {
    "name": "Burak Özdemir",
    "url": "https://ozdemir.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozdemirburak/morse-code-translator.git"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "happy-dom": "^21.0.4",
    "node-web-audio-api": "^2.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "unpkg": "./dist/morse-code-translator.umd.js",
  "jsdelivr": "./dist/morse-code-translator.umd.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/morse-code-translator.es.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.js",
    "dist/*.js.map",
    "dist/index.d.ts",
    "dist/types.d.ts"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly && tsc -p tsconfig.test.json",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "release": "npm run build && npm test && npm publish"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.10.0",
      "onFail": "error"
    }
  }
}
